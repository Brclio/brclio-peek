{
  "name": "brclio-peek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "preview:cloudflare": "npm run build && wrangler dev",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview:pages": "npm run build && wrangler pages dev dist",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name brclio-peek"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wrangler": "4.149.0"
  }
}
